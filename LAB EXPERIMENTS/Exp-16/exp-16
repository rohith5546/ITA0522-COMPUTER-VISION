
import cv2

# Read the input image
img = cv2.imread("image.jpg")

if img is None:
    print("Error: Cannot open image file")
    exit()

# Convert to grayscale
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

# Apply Sobel filters
sobel_x = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=3)
sobel_y = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=3)

# Combine horizontal and vertical edges
sobel = cv2.magnitude(sobel_x, sobel_y)

# Convert result to 8-bit image
sobel = cv2.convertScaleAbs(sobel)

# Create small display windows
cv2.namedWindow("Original Image", cv2.WINDOW_NORMAL)
cv2.namedWindow("Sobel Filtered Image", cv2.WINDOW_NORMAL)
cv2.resizeWindow("Original Image", 400, 300)
cv2.resizeWindow("Sobel Filtered Image", 400, 300)

cv2.imshow("Original Image", img)
cv2.imshow("Sobel Filtered Image", sobel)

print("Sobel edge detection completed!")
cv2.waitKey(0)
cv2.destroyAllWindows()
