
import cv2
import os

# Get the folder containing this Python file
folder = os.path.dirname(os.path.abspath(__file__))

# Read the input colour image
image_path = os.path.join(folder, "image.jpg")
img = cv2.imread(image_path)

if img is None:
    print("Image not found!")
    exit()

# Convert image to grayscale
gray = cv2.cvtColor(
    img, cv2.COLOR_BGR2GRAY
)

# Load face detector
face_cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades +
    "haarcascade_frontalface_default.xml"
)

# Load eye detector
eye_cascade = cv2.CascadeClassifier(
    cv2.data.haarcascades +
    "haarcascade_eye.xml"
)

# Detect faces
faces = face_cascade.detectMultiScale(
    gray,
    scaleFactor=1.1,
    minNeighbors=5
)

# Detect eyes inside each face
for (x, y, w, h) in faces:

    face_gray = gray[y:y+h, x:x+w]
    face_color = img[y:y+h, x:x+w]

    eyes = eye_cascade.detectMultiScale(
        face_gray,
        scaleFactor=1.1,
        minNeighbors=5
    )

    for (ex, ey, ew, eh) in eyes:

        # Draw rectangle around eyes
        cv2.rectangle(
            face_color,
            (ex, ey),
            (ex + ew, ey + eh),
            (0, 255, 0),
            2
        )

        cv2.putText(
            face_color,
            "Eye",
            (ex, ey - 5),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            (0, 255, 0),
            1
        )

print("Eye detection completed!")

# Resize output for screenshot
output = cv2.resize(img, (600, 400))

# Display result
cv2.namedWindow(
    "Eye Detection", cv2.WINDOW_NORMAL
)

cv2.resizeWindow(
    "Eye Detection", 600, 400
)

cv2.imshow("Eye Detection", output)

cv2.waitKey(0)
cv2.destroyAllWindows()
