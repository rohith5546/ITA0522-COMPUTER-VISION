
import cv2
import os

# Get the folder containing this Python file
folder = os.path.dirname(os.path.abspath(__file__))

# Read input video
video_path = os.path.join(folder, "sample.mp4")

cap = cv2.VideoCapture(video_path)

if not cap.isOpened():
    print("Video not found!")
    exit()

# Get video properties
fps = cap.get(cv2.CAP_PROP_FPS)

width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))

# Store all frames
frames = []

while True:
    ret, frame = cap.read()

    if not ret:
        break

    frames.append(frame)

cap.release()

if len(frames) == 0:
    print("No frames found!")
    exit()

# Create output video
output_path = os.path.join(
    folder, "reverse_video.mp4"
)

fourcc = cv2.VideoWriter_fourcc(*"mp4v")

out = cv2.VideoWriter(
    output_path,
    fourcc,
    fps if fps > 0 else 25,
    (width, height)
)

# Write frames in reverse order
for frame in reversed(frames):
    out.write(frame)

out.release()

print("Reverse video created successfully!")
print("Saved as:", output_path)

# Display reverse video
reverse = cv2.VideoCapture(output_path)

cv2.namedWindow("Reverse Video", cv2.WINDOW_NORMAL)
cv2.resizeWindow("Reverse Video", 640, 360)

while True:
    ret, frame = reverse.read()

    if not ret:
        break

    small_frame = cv2.resize(frame, (640, 360))

    cv2.imshow("Reverse Video", small_frame)

    if cv2.waitKey(int(1000 / (fps if fps > 0 else 25))) & 0xFF == ord('q'):
        break

reverse.release()
cv2.destroyAllWindows()
