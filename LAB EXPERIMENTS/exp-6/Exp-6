
import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read the original color image
img = cv2.imread('image.jpg')

if img is None:
    print("Error: Image not found")
else:
    # Create a kernel for erosion
    kernel = np.ones((5, 5), np.uint8)

    # Apply erosion directly to the color image
    eroded = cv2.erode(img, kernel, iterations=1)

    # Convert BGR to RGB for displaying with Matplotlib
    original_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    eroded_rgb = cv2.cvtColor(eroded, cv2.COLOR_BGR2RGB)

    # Display original and eroded color images
    plt.subplot(1, 2, 1)
    plt.imshow(original_rgb)
    plt.title('Original Color Image')
    plt.axis('off')

    plt.subplot(1, 2, 2)
    plt.imshow(eroded_rgb)
    plt.title('Eroded Color Image')
    plt.axis('off')

    plt.tight_layout()
    plt.show()
