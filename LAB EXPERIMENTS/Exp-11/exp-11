
import cv2

# Read the original image
img = cv2.imread("image.jpg")

# Check whether the image was loaded
if img is None:
    print("Error: Cannot open image file")
    exit()

# Rotate the image 180 degrees
rotated_img = cv2.rotate(
    img, cv2.ROTATE_180
)

# Display both images
cv2.imshow("Original Image", img)
cv2.imshow("Image Rotated 180 Degrees", rotated_img)

print("Image rotated 180 degrees successfully!")
print("Press any key to close the windows.")

cv2.waitKey(0)
cv2.destroyAllWindows()
