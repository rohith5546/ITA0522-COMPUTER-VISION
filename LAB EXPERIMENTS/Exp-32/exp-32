
import cv2
import numpy as np

def colored_boxes():
    height = int(input("Enter image height: "))
    width = int(input("Enter image width: "))

    img = np.ones((height, width, 3), dtype=np.uint8) * 255

    box_h = height // 10
    box_w = width // 10

    # Black box: top-left
    img[0:box_h, 0:box_w] = (0, 0, 0)

    # Blue box: top-right
    img[0:box_h, width-box_w:width] = (255, 0, 0)

    # Green box: bottom-left
    img[height-box_h:height, 0:box_w] = (0, 255, 0)

    # Red box: bottom-right
    img[height-box_h:height, width-box_w:width] = (0, 0, 255)

    small_img = cv2.resize(img, (400, 300))

    cv2.imshow("Four Colored Boxes", small_img)
    cv2.waitKey(0)
    cv2.destroyAllWindows()

colored_boxes()
