
import cv2
import numpy as np

# Read the original image
img = cv2.imread("image.jpg")

if img is None:
    print("Error: Cannot open image file")
    exit()

height, width = img.shape[:2]

# Select three points from the original image
src_points = np.float32([
    [0, 0],
    [width - 1, 0],
    [0, height - 1]
])

# Define destination points for affine transformation
dst_points = np.float32([
    [width * 0.1, height * 0.2],
    [width * 0.9, height * 0.1],
    [width * 0.2, height * 0.9]
])

# Calculate the affine transformation matrix
matrix = cv2.getAffineTransform(src_points, dst_points)

# Apply the affine transformation
transformed_img = cv2.warpAffine(
    img, matrix, (width, height)
)

# Create small display windows
cv2.namedWindow("Original Image", cv2.WINDOW_NORMAL)
cv2.namedWindow("Affine Transformed Image", cv2.WINDOW_NORMAL)

cv2.resizeWindow("Original Image", 400, 300)
cv2.resizeWindow("Affine Transformed Image", 400, 300)

# Display the images
cv2.imshow("Original Image", img)
cv2.imshow("Affine Transformed Image", transformed_img)

print("Affine transformation completed successfully!")
print("Press any key to close the windows.")

cv2.waitKey(0)
cv2.destroyAllWindows()
